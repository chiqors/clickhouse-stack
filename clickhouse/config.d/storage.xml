<clickhouse>
    <!-- Storage/compute separation: data lives on MinIO (S3-compatible). -->
    <storage_configuration>
        <disks>
            <!-- Standard S3 disk with local metadata + a 10 GiB read cache. -->
            <s3_minio>
                <type>s3</type>
                <endpoint>http://minio:9000/clickhouse/data/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse-secret</secret_access_key>
                <region>us-east-1</region>
                <use_environment_credentials>false</use_environment_credentials>
                <metadata_path>/var/lib/clickhouse/disks/s3_minio/</metadata_path>
                <support_batch_delete>true</support_batch_delete>
            </s3_minio>

            <s3_cache>
                <type>cache</type>
                <disk>s3_minio</disk>
                <path>/var/lib/clickhouse/disks/s3_cache/</path>
                <max_size>10Gi</max_size>
                <cache_on_write_operations>1</cache_on_write_operations>
            </s3_cache>

            <!-- Cost-optimized disk: plain_rewritable stores part metadata IN
                 the bucket (no per-file local sidecar). Combined with the
                 table-level min_bytes_for_full_part_storage setting, each
                 part becomes a single S3 object. -->
            <s3_minio_packed>
                <type>object_storage</type>
                <object_storage_type>s3</object_storage_type>
                <metadata_type>plain_rewritable</metadata_type>
                <endpoint>http://minio:9000/clickhouse/packed/</endpoint>
                <access_key_id>clickhouse</access_key_id>
                <secret_access_key>clickhouse-secret</secret_access_key>
                <region>us-east-1</region>
                <use_environment_credentials>false</use_environment_credentials>
            </s3_minio_packed>
        </disks>

        <policies>
            <s3_main>
                <volumes>
                    <main>
                        <disk>s3_cache</disk>
                    </main>
                </volumes>
            </s3_main>
            <s3_packed>
                <volumes>
                    <main>
                        <disk>s3_minio_packed</disk>
                    </main>
                </volumes>
            </s3_packed>
        </policies>
    </storage_configuration>

    <!-- Make the S3 policy the default so new MergeTree tables land on MinIO. -->
    <merge_tree>
        <storage_policy>s3_main</storage_policy>
    </merge_tree>
</clickhouse>
