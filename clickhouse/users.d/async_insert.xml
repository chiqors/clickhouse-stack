<clickhouse>
    <profiles>
        <default>
            <!-- Coalesce many small INSERTs into one part before writing to S3.
                 - async_insert=1          : enable server-side buffering
                 - wait_for_async_insert=0 : client returns as soon as the row
                                             is in the in-memory queue
                 - size/time thresholds    : flush when either is hit -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>0</wait_for_async_insert>
            <async_insert_max_data_size>10485760</async_insert_max_data_size>  <!-- 10 MiB -->
            <async_insert_busy_timeout_ms>2000</async_insert_busy_timeout_ms>
        </default>
    </profiles>
</clickhouse>
